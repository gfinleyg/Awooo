  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\ant_native.cpp" />
  </ItemGroup>



  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <PropertyGroup Label="ANT SDK">
    <ANTLibRoot Condition="'$(ANTLibRoot)' == ''">..\ANT_LIB</ANTLibRoot>
  </PropertyGroup>

  <!--
    AntWorkout vendoring.

    AntWorkout is a sibling project/folder that consumes this project's
    compiled extension module and the "ant" Python package. Rather than
    AntWorkout reaching across into this checkout (or someone copying
    files by hand between the two), every build here drops a fresh copy
    of both into AntWorkout\AntNative\, mirroring this project's own
    layout: python\ant\... and build\<Configuration>\ant_native.pyd.

    That mirrored layout matters: ant\transport\native.py locates
    ant_native.pyd by walking 3 parents up from its own file location
    (transport -> ant -> python -> project root) and looking in
    build\Release (or Debug) there. Copying "ant" straight into
    AntWorkout\AntNative\python\ant (not AntWorkout\ant) preserves that
    same depth, so native.py's existing lookup logic keeps working
    unmodified in both the original checkout and the vendored copy -
    AntWorkout only needs to add AntWorkout\AntNative\python to its own
    sys.path before importing "ant".

    Override the destination with /p:AntWorkoutRoot=<path> (or set it in
    build_windows.ps1) if AntWorkout doesn't live at ..\AntWorkout
    relative to this project.
  -->
  <PropertyGroup Label="AntWorkout Vendoring">
    <AntWorkoutRoot Condition="'$(AntWorkoutRoot)' == ''">$(MSBuildProjectDirectory)\..\AntWorkout</AntWorkoutRoot>
  </PropertyGroup>

  <Target Name="CopyToAntWorkout" AfterTargets="Build">
    <ItemGroup>
      <!-- *.py only, so __pycache__ is skipped without an explicit exclude -->
      <AntPythonSource Include="$(MSBuildProjectDirectory)\python\ant\**\*.py" />
      <AntNativeBinary Include="$(OutDir)$(TargetName).pyd" />
      <AntNativeBinary Include="$(OutDir)$(TargetName).pdb" Condition="Exists('$(OutDir)$(TargetName).pdb')" />
    </ItemGroup>

    <MakeDir Directories="$(AntWorkoutRoot)\AntNative\python\ant"
             Condition="!Exists('$(AntWorkoutRoot)\AntNative\python\ant')" />
    <MakeDir Directories="$(AntWorkoutRoot)\AntNative\build\$(Configuration)"
             Condition="!Exists('$(AntWorkoutRoot)\AntNative\build\$(Configuration)')" />

    <!-- The ant package is sometimes edited in AntWorkout's copy: never replace a file there that's newer
         than this checkout's (robocopy /XO), and warn so it gets copied back here -->
    <Exec Command="robocopy &quot;$(MSBuildProjectDirectory)\python\ant&quot; &quot;$(AntWorkoutRoot)\AntNative\python\ant&quot; *.py /S /XO /XD __pycache__ /NJH /NJS /NDL /NP /NC"
          IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="AntPythonCopyExit" />
    </Exec>
    <Error Condition="$(AntPythonCopyExit) &gt;= 8" Text="Copying the ant package into $(AntWorkoutRoot) failed (robocopy exit $(AntPythonCopyExit))" />
    <Exec Command="robocopy &quot;$(MSBuildProjectDirectory)\python\ant&quot; &quot;$(AntWorkoutRoot)\AntNative\python\ant&quot; *.py /S /L /XN /XL /XC /XX /XD __pycache__ /NJH /NJS /NDL /NP /NC /NS /FP"
          IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="AntPythonNewerThere" />
    </Exec>
    <Warning Condition="'@(AntPythonNewerThere)' != ''"
             Text="Kept AntWorkout's newer copy (copy it back to python\ant here): %(AntPythonNewerThere.Identity)" />

    <Copy SourceFiles="@(AntNativeBinary)"
          DestinationFolder="$(AntWorkoutRoot)\AntNative\build\$(Configuration)"
          SkipUnchangedFiles="true" />

    <Message Importance="high"
             Text="Vendored ant package + $(TargetName).pyd into $(AntWorkoutRoot)\AntNative" />
  </Target>

</Project>