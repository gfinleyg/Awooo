<?xml version="1.0" encoding="utf-8"?>
<!--
  antnative.dll: the AntNative core behind the C API (include\antnative.h), for C, C++ (include\antnative.hpp)
  and anything else that can call a C DLL. No Python involved; ant_native.vcxproj builds the Python module.

  Output: build\<Configuration>\antnative.dll + antnative.lib (import library). Build it with build_windows.ps1,
  or on its own:  msbuild antnative.vcxproj /p:Configuration=Release /p:Platform=x64 /p:ANTLibRoot=<ANT_LIB>
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6E0B5C1A-3F8D-4C2E-9A71-B4D2E8F05C39}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>antnative</RootNamespace>
    <ProjectName>antnative</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\obj\$(Configuration)\antnative\</IntDir>
    <TargetName>antnative</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>WIN32;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\include;$(ANTLibRoot)\inc;$(ANTLibRoot)\software\serial;$(ANTLibRoot)\software\serial\device_management;$(ANTLibRoot)\software\system;$(ANTLibRoot)\software\USB;$(ANTLibRoot)\software\USB\devices;$(ANTLibRoot)\software\USB\device_handles;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(ANTLibRoot)\x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ANT_LIB.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\core\ant_core.cpp" />
    <ClCompile Include="src\core\ant_pages.cpp" />
    <ClCompile Include="src\core\ant_profiles.cpp" />
    <ClCompile Include="src\core\ant_manager.cpp" />
    <ClCompile Include="src\core\ant_recovery.cpp" />
    <ClCompile Include="src\c_api\antnative_c.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\core\ant_core.hpp" />
    <ClInclude Include="src\core\ant_pages.hpp" />
    <ClInclude Include="src\core\ant_profiles.hpp" />
    <ClInclude Include="src\core\ant_manager.hpp" />
    <ClInclude Include="src\core\ant_recovery.hpp" />
    <ClInclude Include="include\antnative.h" />
    <ClInclude Include="include\antnative.hpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <PropertyGroup Label="ANT SDK">
    <ANTLibRoot Condition="'$(ANTLibRoot)' == ''">..\..\antlib\ANT_LIB</ANTLibRoot>
  </PropertyGroup>
</Project>
