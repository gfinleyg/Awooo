# Python bytecode
__pycache__/
*.pyc

# AntNative build intermediates and debug symbols (the .pyd modules in build/Release are what the apps load, those
# stay tracked, as do antnative.dll and its import library antnative.lib, which C/C++ programs link against)
AntNative/build/obj/
AntNative/build/Release/*.exp
AntNative/build/Release/*.lib
!AntNative/build/Release/antnative.lib
AntNative/build.log
*.pdb

# PyInstaller's work folder and output (see "Building the exe" in AntWorkout/README.md)
AntWorkout/build/
AntWorkout/dist/

# AntWorkoutQt's CMake build folders and its dist\ (see AntWorkoutQt/build_windows.ps1)
AntWorkoutQt/build/
AntWorkoutQt/dist/

# Written while the apps run: logs, settings and caches, SimulantTests results
*_console.log
antWorkoutLog.txt
*.tmp
AntWorkout/layoutScreenshots/
AntWorkout/savedSettingsANT.json
AntWorkout/musicCadenceCacheANT.json
AntWorkout/musicSelectionANT.json
AntWorkout/workoutPickerANT.json
AntWorkout/SimulantTests/run/

# The old native AntWorkout.exe, replaced by AntWorkoutBridge
*.exe.old

# vscode settings
/.vscode/

# Personal Claude Code instructions, settings and hooks
/CLAUDE.local.md
/.claude/settings.local.json
/.claude/hooks/